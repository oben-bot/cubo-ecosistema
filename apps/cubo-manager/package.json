{
  "scripts": {
    "react-start": "react-scripts start",
    "build": "react-scripts build",
    "electron:start": "npm run build && electron .",
    "start": "react-scripts start",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run react-start\" \"electron .\"",
    "electron:build": "npm run build && electron-builder --config electron/builder.config.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\""
  },
  "dependencies": {
    "autoprefixer": "^10.0.0",
    "chart.js": "^4.4.9",
    "postcss": "^8",
    "react": "^18.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.5.2",
    "react-scripts": "^5.0.0",
    "sharp": "^0.32.0",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "main": "electron/main.js",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3",
    "wait-on": "^9.0.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "."
}
