{
  "name": "@cubo/taller",
  "version": "1.0.0",
  "private": true,
  "description": "Taller parametrico: servicio local (127.0.0.1) con bandeja temporal y constructores (texto, cajas, llaveros).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test pruebas/*.test.ts"
  },
  "dependencies": {
    "clipper2-js": "1.2.4",
    "opentype.js": "1.2.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
